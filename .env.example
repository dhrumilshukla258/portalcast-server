REMOTE_HOST=your_remote_host
REMOTE_DIR=/path/to/remote/dir
IMAGE_NAME=portalcast-server
ADMIN_PASSWORD=admin
JWT_SECRET=your_jwt_secret
TMDB_API_READ_TOKEN=your_tmdb_api_read_access_token
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com,anotheradmin@example.com

# SMTP Mail Configurations (for Admin Approval Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Portalcast" <your_smtp_username>
