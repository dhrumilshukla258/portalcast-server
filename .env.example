# Node's sqlite3 driver queries run on libuv's threadpool (default size 4,
# shared with all other async I/O) — bump this for local dev too if you see
# unrelated requests stall while a DB-heavy endpoint (e.g. Discover) is busy.
# Must be set before Node starts; already set in the Dockerfile for prod.
UV_THREADPOOL_SIZE=16

REMOTE_HOST=your_remote_host
REMOTE_DIR=/path/to/remote/dir
IMAGE_NAME=portalcast-server
ADMIN_PASSWORD=admin
JWT_SECRET=your_jwt_secret
TMDB_API_READ_TOKEN=your_tmdb_api_read_access_token
# Optional (free key at https://www.omdbapi.com/apikey.aspx): Rotten Tomatoes + Metacritic
# scores, looked up by IMDb id. The free key allows 1,000 calls a day.
# Several keys: comma-separated (key1,key2,key3); each is used up to OMDB_DAILY_LIMIT a day.
OMDB_API_KEY=your_omdb_api_key
# OMDB_DAILY_LIMIT=900
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key
# Second subtitle source (free key at https://subdl.com): ~2,000 searches, ~50 downloads per day
SUBDL_API_KEY=your_subdl_api_key

# Jellyfin as the source of My Library (optional; also in Admin > Settings > Jellyfin).
# Its movie and show libraries are read from it; streams and artwork go through this server.
# JELLYFIN_URL=http://192.168.1.10:8096
# JELLYFIN_API_KEY=            (Jellyfin Dashboard > API Keys)

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com,anotheradmin@example.com

# SMTP Mail Configurations (for Admin Approval Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Portalcast" <your_smtp_username>

# --- Security ---
# Behind a reverse proxy (nginx, Caddy, Traefik, Docker): which addresses may set
# X-Forwarded-For. Without this every viewer shares the proxy's address, so rate limits
# and automatic bans cannot tell them apart (auto-bans stay off).
#   private              = trust loopback and LAN/Docker addresses (the usual home setup)
#   10.0.0.5,172.18.0.0/16 = explicit addresses / IPv4 CIDRs
TRUSTED_PROXIES=private
# Automatic temporary ban: this many failed sign-ins / bad tokens in 15 minutes bans the
# address for this many minutes. Admin > Security shows and lifts bans.
SECURITY_BAN_AFTER=20
SECURITY_BAN_MINUTES=60
# Let clients that ask (TV "Direct live streams") be redirected to the provider CDN. Off:
# everything is relayed and the provider address never reaches a client.
ALLOW_DIRECT_STREAMS=false
